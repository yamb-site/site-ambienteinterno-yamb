# Cloudflare Pages — cabeçalhos
# HTML sempre fresco: uma publicação nova aparece na hora
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Gerados por scripts/otimizar.py: o nome muda quando o conteúdo muda, então podem ficar 1 ano
/assets/otim/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Ambiente interno fora dos buscadores
/interno/*
  X-Robots-Tag: noindex, nofollow
